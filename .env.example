# Authentication owner: kiro-cli (default) or kas (KiroCrew vault).
KCLW_BACKEND=kiro-cli

# Executable paths, not shell commands. Only the selected backend's binary is used.
# Use absolute paths if your daemon environment has a limited PATH.
KCLW_KIRO_BIN=kiro-cli
KCLW_KIROCREW_BIN=kirocrew

# KAS uses `kirocrew kas ...`, not `kiro-agent login`.
# Run as the same OS user and with the same home as the KiroCrew gateway.
# KIROCREW_HOME=/path/to/your/crew-home

# Both backends support: identity-center, builder-id, google, github.
# Identity Center requires a known Start URL and region.
KCLW_AUTH_METHOD=identity-center
KCLW_IDENTITY_PROVIDER=https://d-example.awsapps.com/start
KCLW_REGION=ap-northeast-1

# Internal scheduler. No crontab is required.
KCLW_CHECK_INTERVAL=5m

# Optional: proactively force logout + device login after this interval.
# Leave 0 to re-authenticate only when the selected backend reports signed out.
# KAS logout removes ALL identities in the selected KiroCrew vault.
KCLW_FORCE_RELOGIN_INTERVAL=0

KCLW_COMMAND_TIMEOUT=20s
KCLW_LOGIN_TIMEOUT=15m
KCLW_NOTIFY_SUCCESS=true

# Telegram notifier. Never commit a real token.
KCLW_TELEGRAM_BOT_TOKEN=replace-me
KCLW_TELEGRAM_CHAT_ID=replace-me

# Optional paths. Use distinct state directories to monitor both backends at once.
# KCLW_STATE_DIR=~/.local/state/kiro-cli-login-watchdog
# KCLW_PID_FILE=/path/to/watchdog.pid
# KCLW_LOG_FILE=/path/to/watchdog.log
